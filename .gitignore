__pycache__/
*.pyc
.env
instance/*.db
.venv/
venv/
.DS_Store
*.log
# migration files SHOULD be committed — only ignore alembic's local cache
*.pyc.bak
# Playwright test artifacts — regenerated on every test run, bloat the repo
tests/screenshots/
tests/REPORT.md

# server-side temp files
*.bak
cleanup_test_users.py
gunicorn.log*
app/static/logos/
# MARSOUD-68 — uploaded company attachments (invoices, contracts, task
# files). These are tenant data — must NEVER be committed to the repo.
app/static/docs/
# MARSOUD-USER-FILES — per-user private uploads. Same rule as above:
# tenant data, kept outside the repo (and outside static/ so Flask
# won't serve them publicly).
app/private_uploads/
# Database files & backups
instance/
*.db
*.db.bak*
*.db.backup*

# Temp backup files
*.bak
*.bak.*
*.bak-*
