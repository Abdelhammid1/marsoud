# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# MARSOUD-MOBILE-TKT-05 (2026-08-18) — Firebase config files
# are per-project secrets and must never land in the repo.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
ios/Runner/GoogleService-Info-*.plist

# MARSOUD-MOBILE-RELEASE-SIGNING (2026-08-25) — upload key material.
# The Play upload key CANNOT be rotated by you once an app is published
# (only Google can reset it, via a support request). A committed keystore
# is therefore permanent exposure, so these never enter the repo.
android/build/
android/.gradle/
android/key.properties
*.jks
*.keystore
*.p12
