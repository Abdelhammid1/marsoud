<?xml version="1.0" encoding="utf-8"?>
<!-- MARSOUD-MOBILE-BRANDING (2026-08-25) — adaptive launcher icon.
     API 26+ composites background + foreground and applies the
     launcher's own mask (circle / squircle / teardrop). Without this
     file Android falls back to the legacy bitmap and shows it inside a
     white plate, which is why the stock Flutter icon looked boxed. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
